# Copy this file to a new file called .env and fill in your own details.
# Never share the .env file or put it online.
# On Render, these are set under the service's Environment tab instead (no .env file there).

PORT=3000

# SMTP settings for the domain mailbox created in cPanel
# (cPanel > Email Accounts > Connect Devices shows the exact values for your mailbox)
# Usually mail.yourdomain.com. If you get certificate errors, use the server hostname cPanel shows instead.
SMTP_HOST=mail.yourdomain.com
# Render's free plan blocks 25, 465 and 587, so there use the host's alternative port (e.g. 2525 or 26)
SMTP_PORT=465
# true for port 465 (SSL), false for 587 / 2525 / 26 (STARTTLS)
SMTP_SECURE=true
# The full email address of the cPanel mailbox, also used as the sender address
SMTP_USER=info@yourdomain.com
SMTP_PASS=your-mailbox-password

# Where the feedback emails should be delivered (can be the same mailbox as SMTP_USER)
CONTACT_RECEIVER_EMAIL=info@yourdomain.com
