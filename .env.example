# Copy this file to a new file called .env and fill in your own details.
# Never share the .env file or put it online.

PORT=3000

# SMTP settings from your email provider
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# true for port 465, false for port 587
SMTP_SECURE=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where the feedback emails should be delivered
CONTACT_RECEIVER_EMAIL=team-inbox@example.com
